# Copy to .env and fill in what you have (cp .env.example .env). .env is gitignored: never commit real keys.
# Everything is optional: with no keys the demo runs fully offline (stub Lighthouse data,
# offline agent). Synthetic data only. OpenRouter is not covered by a BAA.

# ---------------------------------------------------------------------------------------------
# LLM (OpenRouter). Used by the orchestrator, the intake subagent (DSPy) and the simulator.
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------------------------
OPENROUTER_API_KEY=
# INTAKE_PROVIDER=offline   # force the rule-based agent even with a key (default: dspy if a key is set)

# Models (any OpenRouter model with tool support). DSPy/LiteLLM model ids need the
# "openrouter/" prefix.
# DSPY_MODEL=openrouter/openai/gpt-6-luna
# DSPY_MODEL=openrouter/anthropic/claude-haiku-5.5   # same list price ($0.10/$0.50 per M); thinks by default
# DSPY_SIM_MODEL=openrouter/openai/gpt-6-luna        # simulated veteran used by the eval
# POA_AGENT_MODEL=anthropic/claude-sonnet-5.5        # demo/host_agent.py (OpenAI client id)
# DSPY_CACHE=1                                       # 0 disables DSPy's response cache

# QA web search (OpenRouter web plugin; about $0.007 per search with the default Exa engine,
# plus tokens). Comma-separated domains the search is restricted to.
# QA_SEARCH_DOMAINS=va.gov,benefits.va.gov,ecfr.gov,law.cornell.edu

# ---------------------------------------------------------------------------------------------
# VA Lighthouse. stub = built-in synthetic fixtures (no keys; used by the eval)
#                recorded = saved sandbox responses (no keys)
#                sandbox = live calls to https://sandbox-api.va.gov (keys below)
# Sign up per API at https://developer.va.gov/explore: sandbox credentials are free and
# instant. The Lighthouse terms forbid embedding credentials in open-source projects, so keys
# live only here.
# ---------------------------------------------------------------------------------------------
LIGHTHOUSE_MODE=stub

# Sandbox mode reads OAuth ACCESS TOKENS (the login flow itself isn't built yet). Get them from
# the sandbox's OAuth flow for a test user (see the API pages on developer.va.gov), then paste:
# VA_VSHE_ACCESS_TOKEN=      # Veteran Service History & Eligibility v2 (service_history.read, ...)
# VA_CLAIMS_ACCESS_TOKEN=    # Benefits Claims v1 (claim.read, claim.write)
# VA_TOKEN_ICN=              # REQUIRED with tokens: the ICN of the user the tokens belong to.
#   VA reads the veteran from the token, not from the ICN we pass, so sandbox mode refuses any
#   other case ICN (reading or filing would hit the token user instead). A representative's
#   token would also need X-VA-SSN/-First-Name/-Last-Name/-Birth-Date headers, or VA treats the
#   rep as the claimant: that flow is NOT built, so use a veteran test user's own tokens.
# The representative's VA POA code (config/representative.json "poa_code") is required to
# submit POST /forms/2122 in sandbox mode.
# Then save a test user's responses for everyone else (no keys needed to replay them):
#   uv run intake lighthouse-record --icn <ICN> --label "Sandbox test user"
#   LIGHTHOUSE_MODE=recorded

# ---------------------------------------------------------------------------------------------
# POA skill (already in the repo)
# ---------------------------------------------------------------------------------------------
# POA_DATA_DIR=.data          # vault, PDFs, audit log
# POA_VAULT_KEY=              # Fernet key; generated into POA_DATA_DIR if unset
# POA_LLM_BASE_URL=https://openrouter.ai/api/v1
