# Copy to .env and fill in (cp .env.example .env). .env is gitignored: never commit real keys.
# Synthetic data only. OpenRouter is not covered by a BAA.

# ---------------------------------------------------------------------------------------------
# OpenRouter: required for the demo, `intake simulate`, `intake eval` and `intake support-eval`.
# There are no offline agents; the tests need no key (they use a scripted fake model).
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Model for every agent, and for the simulated veteran in the eval (LiteLLM ids need the
# "openrouter/" prefix). Prices for cost tracking are in agent/config.py (PRICES); for a slug
# without a price, --max-cost is refused (its calls would count as $0).
# DSPY_MODEL=openrouter/anthropic/claude-haiku-5.5
# DSPY_SIM_MODEL=openrouter/anthropic/claude-haiku-5.5
# REASONING_EFFORT=low       # low | medium | high | none
# LM_TIMEOUT_S=120           # per model call, in seconds
# DSPY_CACHE=1               # 0 disables DSPy's response cache (eval --trials > 1 does this itself)

# kb_search: OpenRouter's web plugin (Exa engine, about $0.007 per search plus tokens),
# restricted to these domains.
# QA_MODEL=anthropic/claude-haiku-5.5
# QA_SEARCH_DOMAINS=va.gov,benefits.va.gov,ecfr.gov,law.cornell.edu,veteranscrisisline.net
# POA_LLM_BASE_URL=https://openrouter.ai/api/v1   # another OpenAI-compatible endpoint for kb_search

# ---------------------------------------------------------------------------------------------
# Storage: cases (SQLite), traces, the encrypted vault, PDFs and the audit log.
# ---------------------------------------------------------------------------------------------
# POA_DATA_DIR=.data
# POA_VAULT_KEY=              # Fernet key; generated into POA_DATA_DIR if unset
