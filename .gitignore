.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Runtime data: encrypted vault, filled PDFs, vault key, audit log. Never commit.
.data/
.scratch/
.DS_Store

# Local secrets (API keys). Never commit; copy .env.example instead.
.env
.env.*
!.env.example

# Eval output (regenerate with `uv run intake eval`). The midpoint results are kept so they can be
# read without a paid run; their runs/ (filled PDFs, vault, traces) is not.
results/*
!results/midpoint/
results/midpoint/*
!results/midpoint/report.md
!results/midpoint/summary.json
!results/midpoint/transcripts/
!results/support-midpoint/
